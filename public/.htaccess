# Use index.php as the home page, ahead of any default index.html GoDaddy left behind.
DirectoryIndex index.php

Options -Indexes
RewriteEngine On

# Security headers: no MIME sniffing, no framing by other sites, no camera/mic/location, HTTPS remembered once
# the site is on HTTPS (HSTS is only ever sent over HTTPS).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
  Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# Speed: compress text files (about 4x smaller) and let browsers keep CSS, JS, fonts and images. CSS and JS
# links carry ?v=N, which changes on every release, so a long cache never shows an old version.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Never serve hidden files, databases, logs, backups or scripts, even if one is copied here by mistake.
<FilesMatch "(^\.|\.(sqlite|sqlite3|db|sql|bak|old|orig|log|ini|env|zip|tar|gz|7z|rar|sh|ps1|bat|json\.gz)$)">
  Require all denied
</FilesMatch>

# Uncomment these two lines once https://flowsuit.net loads with a padlock
# (GoDaddy SSL is active). Before that, they would break the site.
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Send www.flowsuit.net to flowsuit.net so Google sees one site.
# (keeps https when the visit was on https, so Google sees one address).
RewriteCond %{HTTPS} on
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ http://%1%{REQUEST_URI} [L,R=301]

# Old-style links like /index.php go to the clean URL.
RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
RewriteRule ^ / [L,R=301]

# /erp is reserved for the FlowSuit app (public_html/erp); never route it to this site.
RewriteRule ^erp(/|$) - [L]

# Hide the deploy tool's sync-state file.
RewriteRule (^|/)\.ftp-deploy - [F]

# Real files (CSS, images) are served as-is; everything else goes to index.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
